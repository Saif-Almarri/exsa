# EXSA — .gitignore

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
*.code-workspace

# Temp
*.tmp
*.zip

# Site (lives at exsa.dev — not part of the framework distribution)
*.html
*.php
site/

# Website-specific CSS
demo.css
landing.css
site/splash.css
site/glass.css

# Server config
.htaccess
nginx.conf

# Internal tooling (kept local) — exception: the debug linter generator ships
tools/*
!tools/build-debug.mjs

# Node
node_modules/




*.php
