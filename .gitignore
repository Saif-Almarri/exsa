# EXSA — .gitignore

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
*.code-workspace

# Temp
*.tmp
*.zip

# Site pages (live at exsa.dev — not part of the framework distribution)
*.html
*.php

# Exception: the QA probe pages ship with the release tooling
!site/qa/layer-probe.html
!site/qa/contract-probe.html
!site/qa/layout-probe.html
!site/qa/layout-fixtures/*.html
!site/qa/spell-probe.html

# Website-specific CSS
demo.css
landing.css

# Server config
.htaccess
nginx.conf

# Node
node_modules/




*.php
