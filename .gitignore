# EXSA — .gitignore

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
*.code-workspace

# Temp
*.tmp
*.zip

# Site (lives at exsa.dev — not part of the framework distribution)
*.html
*.php
site/

# Website-specific CSS
demo.css
landing.css
site/splash.css
site/glass.css

# Server config
.htaccess
nginx.conf

# Internal tooling (kept local) — exceptions: the CI validator and its build
# dependencies ship, so the GitHub Actions validate gate is self-contained
tools/*
!tools/build-debug.mjs
!tools/validate.mjs
!tools/build-tokens.mjs
!tools/build-bundle.mjs

# Deploy staging (generated by tools/build-deploy.mjs)
deploy/

# Node
node_modules/




*.php
